# Copy to .env.r2.local and fill in values. Never use VITE_ for credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain, for example https://images.example.com
R2_PUBLIC_URL=
# Optional: override for EU/FedRAMP buckets using the endpoint from Cloudflare.
R2_ENDPOINT=
R2_PREFIX=blog
