REMARK_URL=https://comments.alankyle.com
SITE=alankyle
# Generate on the server: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET=
DEBUG=false
# Nickname-based anonymous comments. Set false when requiring OAuth/email login.
AUTH_ANON=true
AUTH_DEV=false
ALLOWED_HOSTS=https://alankyle.com,https://www.alankyle.com
REMARK_ADDRESS=127.0.0.1
REMARK_PORT=8082
TRUSTED_PROXY=127.0.0.1/32
# Optional OAuth credentials; never place them in VITE_ environment variables.
AUTH_GITHUB_CID=
AUTH_GITHUB_CSEC=
AUTH_GOOGLE_CID=
AUTH_GOOGLE_CSEC=
